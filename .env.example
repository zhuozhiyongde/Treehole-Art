# 多吉云「用户中心 → 密钥管理」中的永久密钥。不要提交真实值。
DOGECLOUD_ACCESS_KEY=
DOGECLOUD_SECRET_KEY=

# CDN/COS 配置。请只在本地 .env 中填写真实的存储桶和端点。
CDN_BUCKET=
CDN_ENDPOINT=
CDN_REGION=ap-beijing
CDN_OBJECT_KEY=release/Treehole-Art.user.js
CDN_PUBLIC_URL=https://cdn.arthals.ink/release/Treehole-Art.user.js
CDN_REFRESH_URL=https://cdn.arthals.ink/release/

# 可选。未配置时，发布脚本使用本机 `gh auth login` 的登录状态。
GITHUB_TOKEN=
GITHUB_REPOSITORY=zhuozhiyongde/Treehole-Art
